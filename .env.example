# Settings for docker compose: copy to .env (beside compose.yaml) and fill in what you need.
# Everything is optional for trying it on this machine (`docker compose up --build`).

# Database password (set it before the first start: Postgres keeps the one it was created with).
POSTGRES_PASSWORD=change-me

# Port on this machine for compose.yaml alone (8766 if the local app already uses 8765).
#GUITARR_PORT=8765

# Postgres on this machine, for the web service outside Docker (make db-start, make run-service).
#GUITARR_DB_PORT=5442

# The address in sign-in and invitation links. With compose.https.yaml it defaults to https://GUITARR_DOMAIN.
#GUITARR_PUBLIC_URL=http://localhost:8765

# Sign-in emails. Without GUITARR_SMTP_HOST the link is printed to the log (make logs S=guitarr),
# or make one yourself: make login EMAIL=you@example.com
#GUITARR_SMTP_HOST=smtp.example.com
#GUITARR_SMTP_PORT=587
#GUITARR_SMTP_USER=
#GUITARR_SMTP_PASSWORD=
#GUITARR_SMTP_TLS=starttls          # ssl on port 465; off for a local mail catcher
#GUITARR_MAIL_FROM=guitarr <no-reply@example.com>

# Limits per user.
#GUITARR_QUOTA_MB=1000               # space for songs and takes
#GUITARR_JOBS_PER_USER=3             # jobs waiting at once

# Emails that see the admin page (comma separated).
#GUITARR_ADMINS=you@example.com

# On the internet (docker compose -f compose.yaml -f compose.https.yaml ...).
#GUITARR_DOMAIN=guitarr.example.com
#GUITARR_LB_SECRET=change-me         # signs the cookie that keeps a browser on one app container
#GUITARR_HTTP_PORT=80
#GUITARR_HTTPS_PORT=443
